# Copiar este archivo como terraform.tfvars y completar los valores.
# terraform.tfvars esta en .gitignore: NUNCA se sube al repositorio.

aws_region   = "us-east-1"
project_name = "ef-dgiti"

# Repositorio PUBLICO de GitHub que clonan las instancias al arrancar
app_repo_url    = "https://github.com/USUARIO/ef-dgiti.git"
app_repo_branch = "main"

# Base de datos: 12 a 40 caracteres, solo letras y numeros
db_username = "appadmin"
db_password = "CambiarEstaClave2026"

# Computo y escalado
instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4
cpu_target           = 50

# Opcionales
# key_name              = "vockey"              # SSH (no es necesario)
# instance_profile_name = "LabInstanceProfile"  # solo si existe en tu cuenta
# enable_nat_gateway    = false                 # plan B si el Sandbox no permite NAT
# enable_alb_access_logs = false                # plan B si falla el bucket de logs
